# Copy this file to .env and fill in a key.

# Atlas answers with the first of these that works: a local model through Ollama, Gemini, then OpenAI.
# One is enough. Voice calls and dictation need the OpenAI key.

# OpenAI. Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Gemini's free tier. Create one at https://aistudio.google.com/apikey
# Google uses what its free tier is sent to improve its products, so keep confidential files off it.
GEMINI_API_KEY=

# auto, openai, gemini or ollama. A named provider is used only if it can be.
ATLAS_PROVIDER=auto

# Where Ollama listens, when you run models on this computer (https://ollama.com).
OLLAMA_HOST=127.0.0.1:11434

# Folder to load when the server starts (optional). Relative paths start at the repo root.
ATLAS_FOLDER=samples/riyadh-tower

# Port of the API server; the web app forwards /api calls to it.
PORT=3001

# Where Atlas keeps its index cache, its logs and exported files.
ATLAS_DATA_DIR=.atlas
ATLAS_LOG_DIR=.logs
ATLAS_EXPORTS_DIR=exports

# Files larger than this are listed as too_large and not read.
ATLAS_MAX_FILE_MB=200

# Most tool rounds per question before Atlas asks the model for its final answer.
ATLAS_MAX_ROUNDS=12
