# Copy this file to .env and fill in your key.

# Required to answer questions. Create one at https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Folder to load when the server starts (optional). Relative paths start at the repo root.
ATLAS_FOLDER=samples/riyadh-tower

# Port of the API server; the web app forwards /api calls to it.
PORT=3001

# Where Atlas keeps its index cache, its logs and exported files.
ATLAS_DATA_DIR=.atlas
ATLAS_LOG_DIR=.logs
ATLAS_EXPORTS_DIR=exports

# Files larger than this are listed as too_large and not read.
ATLAS_MAX_FILE_MB=200

# Most tool rounds per question before Atlas asks the model for its final answer.
ATLAS_MAX_ROUNDS=12
