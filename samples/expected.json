      },
      "items": [
        {
          "text": "Site clearance, hoarding, site offices and enabling works for the whole Site.",
          "page": 4
        },
        {
          "text": "Secant pile shoring, temporary ground anchors and dewatering for a three-level basement.",
          "page": 4
        },
        {
          "text": "Bulk excavation to formation level and disposal of excavated material off Site.",
          "page": 4
        },
        {
          "text": "Bored cast-in-place piles, pile testing, pile caps and the basement raft foundation.",
          "page": 4
        },
        {
          "text": "Basement walls, slabs and ramps, including waterproofing and its protection.",
          "page": 4
        },
        {
          "text": "Reinforced and post-tensioned concrete superstructure from ground floor to the Level 28 roof.",
          "page": 4
        },
        {
          "text": "Unitised curtain wall facade, podium cladding and external shading fins, including a visual mock-up.",
          "page": 4
        },
        {
          "text": "Blockwork walls, partitions, stairs, balustrades and metalwork.",
          "page": 4
        },
        {
          "text": "Mechanical works: chilled water plant, air handling, ventilation and smoke control.",
          "page": 4
        },
        {
          "text": "Electrical works: low voltage switchboards, standby generators, busbar risers, lighting and earthing.",
          "page": 4
        },
        {
          "text": "Plumbing, drainage, water storage and fire protection systems.",
          "page": 4
        },
        {
          "text": "Vertical transportation: 14 passenger lifts, 2 service lifts and 4 escalators.",
          "page": 4
        },
        {
          "text": "Roof works and the building maintenance unit.",
          "page": 4
        },
        {
          "text": "Testing, commissioning and handover, including as-built drawings and operation and maintenance manuals.",
          "page": 4
        }
      ],
      "exclusions": [
        {
          "text": "Fit-out of retail units, offices and serviced apartments, which will be let under separate contracts.",
          "page": 4
        },
        {
          "text": "Loose furniture, artwork and IT active equipment.",
          "page": 4
        },
        {
          "text": "Utility connection fees payable to the electricity, water and telecom authorities.",
          "page": 4
        }
      ]
    },
